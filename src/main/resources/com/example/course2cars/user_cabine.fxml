<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="410.0" prefWidth="575.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ButtonBar layoutX="180.0" layoutY="14.0" prefHeight="40.0" prefWidth="392.0">
            <buttons>
                <Button fx:id="auto" mnemonicParsing="false" onAction="#changeWindow" prefHeight="26.0" text="Мои автомобили" />
                <Button fx:id="assemble" mnemonicParsing="false" onAction="#changeWindow" text="Сборки" />
                <Button fx:id="userCab" mnemonicParsing="false" onAction="#changeWindow" prefHeight="26.0" prefWidth="147.0" style="-fx-background-color: GRAY;" text="Личный кабинет" />
            </buttons>
        </ButtonBar>
      <TextField fx:id="name" layoutX="78.0" layoutY="224.0" prefHeight="26.0" prefWidth="234.0" />
      <Label layoutX="40.0" layoutY="228.0" text="ФИО" />
      <TextField fx:id="phone" layoutX="96.0" layoutY="265.0" prefHeight="26.0" prefWidth="169.0" />
      <Label fx:id="userCabPhone" layoutX="30.0" layoutY="270.0" text="Телефон" />
      <TextField fx:id="address" layoutX="94.0" layoutY="178.0" prefHeight="26.0" prefWidth="169.0" />
      <Label layoutX="36.0" layoutY="183.0" text="Адрес" />
      <Label fx:id="idShower" layoutX="36.0" layoutY="24.0" prefHeight="35.0" prefWidth="145.0" text="ID: ">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Label layoutX="38.0" layoutY="95.0" text="Логин" />
      <Label layoutX="36.0" layoutY="134.0" text="Пароль" />
      <TextField fx:id="login" layoutX="97.0" layoutY="91.0" />
      <TextField fx:id="password" layoutX="100.0" layoutY="130.0" />
      <Button fx:id="saveNewInfo" layoutX="250.0" layoutY="342.0" mnemonicParsing="false" onAction="#changeInfo" text="Сохранить" />
      <Label fx:id="successfulChange" layoutX="357.0" layoutY="145.0" prefHeight="91.0" prefWidth="161.0" textFill="#00dc16">
         <font>
            <Font size="38.0" />
         </font>
      </Label>
    </children>
</AnchorPane>
