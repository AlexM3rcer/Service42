<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="200.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.course2cars.OwnerController">
   <children>
      <TextField fx:id="addCarNum" layoutX="25.0" layoutY="33.0" promptText="Номерной знак" />
      <TextField fx:id="addCarStamp" layoutX="213.0" layoutY="33.0" promptText="Марка" />
      <TextField fx:id="addCarModel" layoutX="213.0" layoutY="87.0" promptText="Модель" />
      <TextField fx:id="addCarColor" layoutX="26.0" layoutY="87.0" promptText="Цвет" />
      <Button fx:id="addCarConfirmButton" layoutX="275.0" layoutY="151.0" mnemonicParsing="false" onAction="#addCarConfirm" text="Подтвердить" />
      <TextField fx:id="addCarMileage" layoutX="26.0" layoutY="138.0" promptText="Пробег" />
   </children>
</AnchorPane>
