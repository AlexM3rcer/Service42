<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.course2cars.OwnerController">
   <children>
      <ButtonBar layoutX="190.0" layoutY="24.0" prefHeight="40.0" prefWidth="392.0">
         <buttons>
            <Button fx:id="auto" mnemonicParsing="false" onAction="#changeWindow" prefHeight="26.0" style="-fx-background-color: gray;" text="Мои автомобили" />
            <Button fx:id="assemble" mnemonicParsing="false" onAction="#changeWindow" text="Сборки" />
            <Button fx:id="userCab" mnemonicParsing="false" onAction="#changeWindow" prefHeight="26.0" prefWidth="147.0" text="Личный кабинет" />
         </buttons>
      </ButtonBar>
      <ScrollPane fx:id="carPane" hbarPolicy="NEVER" layoutX="14.0" layoutY="64.0" prefHeight="260.0" prefWidth="574.0">
         <content>
            <VBox fx:id="carContent" prefHeight="257.0" prefWidth="558.0" style="-fx-padding-bottom: 20; -fx-padding-top: 20;" />
         </content>
      </ScrollPane>
      <Button layoutX="418.0" layoutY="349.0" mnemonicParsing="false" onAction="#addCar" text="Добавить автомобиль" />
      <Button fx:id="deleteCarButton" layoutX="130.0" layoutY="349.0" mnemonicParsing="false" onAction="#deleteCar" text="Удалить" />
      <TextField fx:id="deleteCarNumber" layoutX="25.0" layoutY="349.0" prefHeight="26.0" prefWidth="92.0" />
   </children>
</AnchorPane>
